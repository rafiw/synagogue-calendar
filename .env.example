# GitHub Gist - for syncing settings across devices
# Get a token at: https://github.com/settings/personal-access-tokens/new
EXPO_PUBLIC_GITHUB_KEY=
EXPO_PUBLIC_GITHUB_GIST_ID=
EXPO_PUBLIC_GITHUB_GIST_FILE_NAME=synagogue-settings.json

# imgbb - for uploading deceased person photos
# Get a key at: https://api.imgbb.com/
EXPO_PUBLIC_IMGBB_API_KEY=
